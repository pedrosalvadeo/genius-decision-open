          },
          "503": {
            "description": "Service paused or backup/capacity unavailable"
          }
        },
        "parameters": [
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            }
          }
        ]
      }
    },
    "/api/club/export": {
      "get": {
        "operationId": "club_export",
        "description": "Export own profile and all original file versions as JSON. Does not publish them; contents are untrusted data.",
        "x-required-scope": "club:read",
        "responses": {
          "200": {
            "description": "Operation completed; see endpoint result."
