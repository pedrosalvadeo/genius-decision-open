diff --git a/tests/test_distill_modality.py b/tests/test_distill_modality.py
new file mode 100644
index 0000000..89e4d14
--- /dev/null
+++ b/tests/test_distill_modality.py
@@ -0,0 +1,151 @@
+"""Distillation must not silently ignore a requested input modality (#1186 item 1)."""
+
+from __future__ import annotations
+
+from io import StringIO
+from pathlib import Path
+
+import pytest
+import typer
+import yaml
+from pydantic import ValidationError
+from rich.console import Console
+
+from soup_cli.config.loader import load_config, load_config_from_string
+from soup_cli.config.schema import SoupConfig
+
+
+def _raw(modality: str | None, mode: str = "token") -> dict:
+    raw = {
+        "base": "test/student",
+        "task": "distill",
+        "backend": "transformers",
+        "data": {"train": "unused.jsonl", "format": "alpaca"},
+        "training": {
+            "teacher_model": "test/teacher",
+            "distill_mode": mode,
+            "quantization": "none",
+            "batch_size": 1,
+        },
+    }
+    if modality is not None:
+        raw["modality"] = modality
+    return raw
+
+
+def _assert_reason(text: str, modality: str) -> None:
+    text = " ".join(text.split())
+    assert "task='distill'" in text
+    assert f"modality={modality!r}" in text
+    assert "text-only" in text
+    assert "modality: text" in text
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_schema_refuses_non_text_distillation(modality: str, mode: str) -> None:
+    with pytest.raises(ValidationError) as caught:
+        SoupConfig(**_raw(modality, mode))
+    _assert_reason(str(caught.value), modality)
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_string_loader_refuses_non_text_distillation(modality: str, mode: str) -> None:
+    with pytest.raises(ValueError) as caught:
+        load_config_from_string(yaml.safe_dump(_raw(modality, mode)))
+    _assert_reason(str(caught.value), modality)
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_file_loader_refuses_non_text_distillation(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, modality: str, mode: str,
+) -> None:
+    output = StringIO()
+    monkeypatch.setattr(
+        "soup_cli.config.loader.console", Console(file=output, width=180, color_system=None)
+    )
+    path = tmp_path / "soup.yaml"
+    path.write_text(yaml.safe_dump(_raw(modality, mode)), encoding="utf-8")
+    with pytest.raises(SystemExit) as caught:
+        load_config(path)
+    assert caught.value.code == 1
+    _assert_reason(output.getvalue(), modality)
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_doctor_config_check_refuses_instead_of_reporting_support(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, modality: str, mode: str,
+) -> None:
+    from soup_cli.commands.doctor import _check_config_support
+
+    output = StringIO()
+    console = Console(file=output, width=180, color_system=None)
+    monkeypatch.setattr("soup_cli.config.loader.console", console)
+    monkeypatch.setattr("soup_cli.commands.doctor.console", console)
+    path = tmp_path / "soup.yaml"
+    path.write_text(yaml.safe_dump(_raw(modality, mode)), encoding="utf-8")
+    with pytest.raises(typer.Exit) as caught:
+        _check_config_support(str(path))
+    assert caught.value.exit_code == 2
+    _assert_reason(output.getvalue(), modality)
+    assert "Config could not be loaded" in output.getvalue()
+    assert "Config check" not in output.getvalue()
+
+
+@pytest.mark.parametrize("modality", [None, "text"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_text_distillation_still_loads(modality: str | None, mode: str) -> None:
+    raw = _raw(modality, mode)
+    for config in (SoupConfig(**raw), load_config_from_string(yaml.safe_dump(raw))):
+        assert config.modality == "text"
+        assert config.training.distill_mode == mode
+        assert config.training.teacher_model == "test/teacher"
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+@pytest.mark.parametrize("mode", ["token", "sequence"])
+def test_doctor_cli_refuses_non_text_distillation(
+    tmp_path: Path, modality: str, mode: str,
+) -> None:
+    from typer.testing import CliRunner
+
+    from soup_cli.cli import app
+    from tests.conftest import strip_ansi
+
+    path = tmp_path / "soup.yaml"
+    path.write_text(yaml.safe_dump(_raw(modality, mode)), encoding="utf-8")
+    result = CliRunner().invoke(app, ["doctor", "--config", str(path)])
+    assert result.exit_code == 2, result.output
+    output = strip_ansi(result.output)
+    _assert_reason(output, modality)
+    assert "Config could not be loaded" in output
+    assert "Config check" not in output
+
+
+@pytest.mark.parametrize("modality", ["vision", "audio"])
+def test_other_task_modalities_are_not_blanket_refused(modality: str) -> None:
+    raw = _raw(modality)
+    raw["task"] = "sft"
+    raw["training"].pop("teacher_model")
+    raw["training"].pop("distill_mode")
+    config = load_config_from_string(yaml.safe_dump(raw))
+    assert config.task == "sft"
+    assert config.modality == modality
+
+
+@pytest.mark.parametrize("backend", ["mlx", "unsloth"])
+def test_existing_backend_refusals_remain(backend: str) -> None:
+    raw = _raw("text")
+    raw["backend"] = backend
+    with pytest.raises(ValidationError, match=f"backend={backend}"):
+        SoupConfig(**raw)
+
+
+def test_teacher_is_still_required() -> None:
+    raw = _raw("text")
+    raw["training"].pop("teacher_model")
+    with pytest.raises(ValidationError, match="teacher_model"):
+        SoupConfig(**raw)
