+++ b/tests/test_locale.py
@@ -0,0 +1,180 @@
+"""Locale regressions for #149; no SSH targets or external services."""
+from __future__ import annotations
+
+import copy
+import datetime
+import importlib.util
+import json
+import locale
+import os
+import subprocess
+
+import pytest
+import yaml
+
+from scan_tasks import scan_task
+from test_golden_findings import (
+    GOLDEN_DIR, SCAN_DEFAULTS, STATE_DIR, _dump_task, _host_vars,
+    _load_fixture, _normalise, _scan_tasks,
+)
+from test_templates import REPO_ROOT, _ansible_playbook_bin, _base_env
+
+SPEC = importlib.util.spec_from_file_location(
+    "cert_facts_locale", REPO_ROOT / "plugins/modules/linux_vitals_cert_facts.py"
+)
+CERT = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(CERT)
+MONTHS = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split()
+LOCALES = ("C", "de_DE.UTF-8", "fr_FR.UTF-8")
+
+
+def _commands(tasks):
+    for task in tasks or []:
+        if "ansible.builtin.command" in task:
+            yield task
+        for key in ("block", "rescue", "always"):
+            yield from _commands(task.get(key))
+
+
+def test_all_scan_and_heal_commands_pin_locale():
+    commands = []
+    for role in ("vitals_scan", "vitals_heal"):
+        for path in sorted((REPO_ROOT / "roles" / role / "tasks").glob("*.yml")):
+            commands.extend(_commands(yaml.safe_load(path.read_text())))
+    assert commands
+    assert [t["name"] for t in commands if t.get("environment", {}).get("LC_ALL") != "C"] == []
+
+
+@pytest.mark.parametrize("locale_name", LOCALES)
+@pytest.mark.parametrize("month", range(1, 13))
+def test_openssl_months_ignore_locale(locale_name, month):
+    previous = locale.setlocale(locale.LC_TIME)
+    try:
+        try:
+            locale.setlocale(locale.LC_TIME, locale_name)
+        except locale.Error:
+            pytest.skip(f"locale {locale_name} is not installed")
+        active = locale.setlocale(locale.LC_TIME)
+        for zone in ("GMT", "UTC"):
+            assert CERT._parse_openssl_time(f"{MONTHS[month - 1]}  1 12:34:56 2024 {zone}") == (
+                datetime.datetime(2024, month, 1, 12, 34, 56, tzinfo=datetime.timezone.utc)
+            )
+        assert locale.setlocale(locale.LC_TIME) == active
+    finally:
+        locale.setlocale(locale.LC_TIME, previous)
+
+
+@pytest.mark.parametrize("value", [
+    "", "not a date", "Dec 32 00:00:00 2024 GMT", "Feb 30 00:00:00 2024 GMT",
+    "Dez 31 23:59:59 2024 GMT", "Dec 31 24:00:00 2024 GMT",
+    "Dec 31 23:59:59 2024 EST", "Dec 31 23:59:59 2024 GMT trailing",
+])
+def test_invalid_openssl_dates_stay_unknown(value):
+    assert CERT._parse_openssl_time(value) is None
+
+
+def _read_dates(before, after):
+    class Module:
+        def run_command(self, command, **kwargs):
+            if "-text" in command:
+                return 0, "Signature Algorithm: sha256WithRSAEncryption", ""
+            lines = ["subject=CN=example.test", "issuer=CN=Example CA"]
+            if before is not None:
+                lines.append("notBefore=" + before)
+            if after is not None:
+                lines.append("notAfter=" + after)
+            return 0, "\n".join(lines), ""
+    return CERT.CertificateReader(Module(), "openssl").parse("synthetic test input")
+
+
+@pytest.mark.parametrize("before,after", [
+    ("Jan 1 00:00:00 2020 GMT", "bad end date"),
+    ("bad start date", "Jan 1 00:00:00 2024 GMT"),
+    (None, None),
+])
+@pytest.mark.parametrize("source", ["file", "endpoint"])
+def test_unparseable_dates_produce_unknown_with_raw_evidence(tmp_path, before, after, source):
+    cert = _read_dates(before, after)
+    cert.update(source=source, path="/etc/ssl/certs/example.crt", host="example.test", port=443)
+    document = yaml.safe_load((REPO_ROOT / "roles/vitals_certs/tasks/main.yml").read_text())
+    finding_task = next(t for t in document[0]["block"] if t["name"] == "Build the certificate findings")
+    defaults = yaml.safe_load((REPO_ROOT / "roles/vitals_certs/defaults/main.yml").read_text())
+    scan_defaults = yaml.safe_load(SCAN_DEFAULTS.read_text())
+    play = [{
+        "hosts": "localhost", "connection": "local", "gather_facts": False,
+        "vars": {**scan_defaults, **defaults,
+                 "ansible_python_interpreter": "{{ ansible_playbook_python }}",
+                 "linux_vitals_cert_files": [cert] if source == "file" else [],
+                 "linux_vitals_cert_endpoint_results": [cert] if source == "endpoint" else [],
+                 "linux_vitals_cert_mismatches": [], "linux_vitals_cert_openssl_available": True},
+        "tasks": [finding_task,
+                  {"ansible.builtin.set_fact": {"linux_vitals_raw_findings": "{{ linux_vitals_cert_findings }}"}},
+                  {"ansible.builtin.include_tasks": str(REPO_ROOT / "roles/vitals_scan/tasks/severity.yml")},
+                  {"ansible.builtin.copy": {"content": "{{ {'findings': linux_vitals_findings, 'unknown': linux_vitals_unknown_count} | to_json }}",
+                                            "dest": str(tmp_path / "findings.json"), "mode": "0600"}}],
+    }]
+    path = tmp_path / "dates.yml"
+    path.write_text(yaml.safe_dump(play, sort_keys=False))
+    subprocess.run([_ansible_playbook_bin(), str(path)], cwd=REPO_ROOT,
+                   env=_base_env(tmp_path), check=True, capture_output=True)
+    result = json.loads((tmp_path / "findings.json").read_text())
+    unknown = [f for f in result["findings"] if f.get("status") == "unknown"]
+    assert int(result["unknown"]) == 1
+    assert len(unknown) == 1
+    reason = unknown[0]["reason"]
+    assert reason
+    for name, raw in (("notBefore", before), ("notAfter", after)):
+        if raw is None or raw.startswith("bad"):
+            assert name in reason
+            assert (raw or "missing") in reason
+    # A bad start date must not hide a separately known expired end date.
+    if after == "Jan 1 00:00:00 2024 GMT":
+        assert any(f["id"] == "cert_expired" for f in result["findings"])
+    assert not any(f["id"] == "cert_endpoint_unreachable" for f in result["findings"])
+
+
+@pytest.mark.parametrize("locale_name", ["de_DE.UTF-8", "fr_FR.UTF-8"])
+def test_localized_probe_fixture_reaches_the_healthy_golden(tmp_path, locale_name):
+    """Run the real probe tasks, replacing only lastb/who with local fixtures.
+
+    Unlike the ordinary golden adapter, this exercises Ansible's command
+    environment. Without LC_ALL=C the fixture emits the localized trailer
+    and boot label, reproducing the false failed_logins finding.
+    """
+    outputs = json.loads((REPO_ROOT / "tests/fixtures/locale_probe_outputs.json").read_text())
+    bin_dir = tmp_path / "bin"
+    bin_dir.mkdir()
+    for command in ("lastb", "who"):
+        script = bin_dir / command
+        script.write_text(
+            "#!/bin/sh\ncase \"$LC_ALL\" in\n"
+            + "\n".join(f"  {loc}) printf '%s\\n' '{values[command]}' ;;"
+                        for loc, values in outputs.items())
+            + "\n  *) exit 92 ;;\nesac\n"
+        )
+        script.chmod(0o700)
+        observed = subprocess.check_output([str(script)], env={"LC_ALL": locale_name}, text=True).strip()
+        assert observed == outputs[locale_name][command].strip()
+    fixture = _load_fixture(STATE_DIR / "ubuntu_healthy.yml")
+    variables = _host_vars(fixture)
+    names = ("Collect recent failed login attempts", "Collect last reboot information")
+    tasks = []
+    for task in _scan_tasks():
+        name = task.get("name", "").removesuffix(" (golden: seeded)")
+        tasks.append(copy.deepcopy(scan_task(name)) if name in names else task)
+    play = [{
+        "hosts": "localhost", "connection": "local", "gather_facts": False,
+        "environment": {"LC_ALL": locale_name, "PATH": str(bin_dir) + os.pathsep + os.environ["PATH"]},
+        "vars": {**yaml.safe_load(SCAN_DEFAULTS.read_text()), **variables,
+                 "output_dir": str(tmp_path)},
+        "tasks": tasks + [_dump_task()],
+    }]
+    path = tmp_path / "scan.yml"
+    path.write_text(yaml.safe_dump(play, sort_keys=False))
+    subprocess.run([_ansible_playbook_bin(), str(path)], cwd=REPO_ROOT,
+                   env=_base_env(tmp_path), check=True, capture_output=True)
+    result = _normalise(json.loads((tmp_path / "localhost.json").read_text())["result"])
+    expected = json.loads((GOLDEN_DIR / "ubuntu_healthy.json").read_text())
+    assert not any(f["id"] == "failed_logins" for f in result["findings"])
+    assert result["last_reboot"] == "2026-09-24 10:55"
+    assert result == expected
