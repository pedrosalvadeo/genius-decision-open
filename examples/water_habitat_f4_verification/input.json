  "assumptions": [
    {
      "id": "A_SYNTHETIC",
      "kind": "SYNTHETIC",
      "statement": "Instancia formal sintética de CF-001; no representa una población ni una intervención real.",
      "provenance": "S1 P03156-P03246 y P03552-P03639; CONFORMANCE_CASES.md, instancia B."
    },
    {
      "id": "A_MODEL",
      "kind": "MODEL",
      "statement": "Instalar crea dos resultados regular/estrés. Mantener preserva los servicios hasta H=2. Las tablas causales y la familia de tres políticas constituyen el modelo completo declarado.",
      "provenance": "CONFORMANCE_CASES.md, instancia B; estipulación sintética."
    },
    {
      "id": "A_INIT",
      "kind": "INITIALIZATION",
      "statement": "La historia h0 lleva a x0 sin servicios e información i0; las tres políticas parten de la misma condición C0.",
      "provenance": "CONFORMANCE_CASES.md, instancia B; testigo inicial sintético."
    },
    {
      "id": "A_INFO",
      "kind": "INFORMATION",
      "statement": "Las observaciones y_installed e y_held no revelan el escenario. El controlador solo dispone de i0, i1 o i2 según el tiempo; las políticas no consultan el estado oculto.",
      "provenance": "CONFORMANCE_CASES.md, instancia B; estipulación del régimen informacional."
    },
    {
      "id": "A_FUNCTIONAL",
      "kind": "CALIBRATION",
      "statement": "f_water y f_habitat miden presencia de servicios con calibración identidad 0/1 o 1/1. Las coordenadas son comunes a todos los puntos.",
      "provenance": "S1 ejemplo agua/hábitat y definición de B."
    },
    {
      "id": "A_COMPOSITION",
      "kind": "MODEL",
      "statement": "Los puertos water y habitat registran conjuntamente los servicios de cada consulta. Las vistas retienen query para no perder su correlación.",
      "provenance": "Presentación finita explícita de la relación conjunta de B."
    },
    {
      "id": "A_RESOURCES",
      "kind": "MODEL",
      "statement": "d_water y d_habitat son demandas físicas distintas del recurso budget, de unidad budget_unit. Cada servicio instalado consume una unidad por instante; sin servicio consume cero.",
      "provenance": "S1 P03216-P03238; tablas sintéticas de B."
    },
    {
      "id": "A_GENERATIVE",
      "kind": "SEMANTIC",
      "statement": "g_empty, g_a, g_h y g_ah son identidades organizacionales completas. Su conservación es inclusión de conjuntos de servicios; la traducción nativa-común es identidad nominal.",
      "provenance": "S1 P03167-P03190; instancia B."
    },
    {
      "id": "A_WELFARE",
      "kind": "CALIBRATION",
      "statement": "l1 y l2 existen en t=0,1,2; living_condition es aplicable a ambos. Sus valores comunes son presencia de agua y hábitat respectivamente. No se afirma una escala empírica de bienestar.",
      "provenance": "S1 P03191-P03207; estipulación sintética."
    },
    {
      "id": "A_SEMANTIC",
      "kind": "SEMANTIC",
      "statement": "Cada hoja refiere al significado (servicios,escenario) indicado. Los servicios permanecen en t=1,2, por lo que ese significado cubre ambos tiempos requeridos por la tarea.",
      "provenance": "S1 P03208-P03215; invariancia explícita de servicios en el modelo."
    },
    {
      "id": "A_TASK",
      "kind": "NORMATIVE",
      "statement": "La tarea sintética exige al menos un servicio en escenario regular y ambos en estrés durante t=1,2, para la frontera formada por l1,l2 hasta H=2. El presupuesto no forma parte de esta tarea.",
      "provenance": "S1 P03208-P03215 y P03235-P03238; no es validación de vida sostenida real."
    },
    {
      "id": "A_PROBABILITY",
      "kind": "PROBABILITY",
      "statement": "Cada instalación tiene probabilidades 3/4 regular y 1/4 estrés; cada mantenimiento tiene condicional uno. Son pesos estipulados, no inferidos de las posibilidades.",
      "provenance": "S1 P03162-P03166; filas sintéticas de B."
    },
    {
      "id": "A_BUDGET",
      "kind": "NORMATIVE",
      "statement": "Para elegibilidad se exige demanda total instantánea del recurso budget como máximo una unidad en toda consulta.",
      "provenance": "S1 P03216-P03238; restricción separada de la tarea."
    }
  ],
